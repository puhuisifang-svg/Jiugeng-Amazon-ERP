# Non-sensitive local settings only. Do not place credential values in this file.
ERP_MYSQL_DATABASE=jiugeng_erp
ERP_MYSQL_USER=jiugeng_erp
ERP_MYSQL_PORT=13306
ERP_REDIS_PORT=16379
ERP_MINIO_API_PORT=19000
ERP_MINIO_CONSOLE_PORT=19001

# Optional override. Default: the gitignored .local/secrets directory created by
# ./scripts/ops/init-local-secrets.sh. Never place credential values here.
# ERP_LOCAL_SECRET_DIR=/protected/path/jiugeng-erp-local-secrets
