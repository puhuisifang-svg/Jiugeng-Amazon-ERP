{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jiugeng:collector:integrity-result:v1",
  "type": "object",
  "required": ["runId", "result", "checks", "evaluatedAt"],
  "properties": {
    "runId": {"type": "string"},
    "result": {"enum": ["COMPLETE", "INCOMPLETE", "FAILED"]},
    "checks": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["code", "passed"], "properties": {"code": {"enum": ["SOURCE_SUCCEEDED", "PAGES_COMPLETE", "COUNT_MATCH", "ASIN_UNIQUE", "EVIDENCE_HASH_PRESENT"]}, "passed": {"type": "boolean"}, "actual": {"type": ["string", "number", "boolean", "null"]}}, "additionalProperties": false}},
    "evaluatedAt": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
