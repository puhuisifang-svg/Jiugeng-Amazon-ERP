{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jiugeng.example/schemas/capabilities-v1.json",
  "contractVersion": "1.0",
  "roles": ["ADMIN", "PRODUCT_MATERIAL", "SELECTION"],
  "capabilities": [
    "system.users.manage",
    "products.read", "products.write",
    "listings.read", "listings.write",
    "materials.read", "materials.write",
    "inventory.read", "inventory.write",
    "selection.read", "selection.write",
    "watch.read", "watch.write",
    "imports.read", "imports.template.download", "imports.validate", "imports.commit", "imports.cancel", "imports.result.download",
    "audit.read.all", "audit.read.self"
  ],
  "roleCapabilities": {
    "ADMIN": [
      "system.users.manage", "products.read", "products.write", "listings.read", "listings.write",
      "materials.read", "materials.write", "inventory.read", "inventory.write", "selection.read",
      "selection.write", "watch.read", "watch.write", "imports.read", "imports.template.download",
      "imports.validate", "imports.commit", "imports.cancel", "imports.result.download", "audit.read.all", "audit.read.self"
    ],
    "PRODUCT_MATERIAL": [
      "products.read", "products.write", "listings.read", "listings.write", "materials.read",
      "materials.write", "inventory.read", "inventory.write", "selection.read", "watch.read",
      "imports.read", "imports.template.download", "imports.validate", "imports.commit", "imports.cancel",
      "imports.result.download", "audit.read.self"
    ],
    "SELECTION": [
      "products.read", "listings.read", "materials.read", "selection.read", "selection.write",
      "watch.read", "watch.write", "audit.read.self"
    ]
  },
  "deferredImplementation": ["IAM_SESSION", "TOKEN", "ROUTE_GUARD", "BUTTON_CAN", "API_AUTHORIZATION", "ROLE_ADMIN_UI"],
  "invariants": [
    "roles initialize capability sets; APIs and clients evaluate capabilities",
    "SELECTION receives no imports capability",
    "stores.write is intentionally undefined",
    "StoreAccount credentials remain protected SecretRef metadata outside business roles"
  ]
}
