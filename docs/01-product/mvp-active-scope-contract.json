{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jiugeng.example/contracts/mvp-active-scope-v1.json",
  "contractVersion": "1.3",
  "decision": "DEC-012",
  "status": "APPROVED",
  "roles": ["ADMIN", "PRODUCT_MATERIAL", "SELECTION"],
  "domains": {
    "iamAudit": ["User", "Role", "Session", "AuditEvent"],
    "product": ["Product", "ProductVariant", "VariantAttribute", "Supplier", "CatalogImageAsset"],
    "materialInventory": ["AuxiliaryMaterial", "ProductAuxiliaryMaterial", "AuxiliaryMaterialSupplier", "Warehouse", "InventoryBalance", "InventoryTransaction"],
    "selection": ["SelectionCandidate", "CandidateNote", "CandidateEvidence"],
    "watch": ["WatchStore", "CollectorRun", "StoreSnapshot", "StoreSnapshotItem", "NewListingEvent"],
    "importExport": ["ImportBatch", "ImportIssue", "ImportPreview", "ImportResultFile"],
    "purchase": ["PurchaseOrder", "PurchaseOrderLine", "PurchaseReceipt", "PurchaseReceiptLine"],
    "monitoring": ["MonitorTarget", "MonitorSnapshot", "MonitorPreference"]
  },
  "importTypes": [
    {"id": "PRODUCTS", "resource": "products", "templateVersion": "2.0", "dependsOn": []},
    {"id": "VARIANTS", "resource": "variants", "templateVersion": "2.0", "dependsOn": ["PRODUCTS"]},
    {"id": "AUXILIARY_MATERIALS", "resource": "auxiliary_materials", "templateVersion": "1.0", "dependsOn": []},
    {"id": "PRODUCT_AUXILIARY_MATERIALS", "resource": "product_auxiliary_materials", "templateVersion": "1.0", "dependsOn": ["VARIANTS", "AUXILIARY_MATERIALS"]},
    {"id": "AUXILIARY_MATERIAL_OPENING_INVENTORY", "resource": "auxiliary_material_opening_inventory", "templateVersion": "1.0", "dependsOn": ["AUXILIARY_MATERIALS", "WAREHOUSE"]}
  ],
  "apiResourceFamilies": [
    "/api/v1/auth",
    "/api/v1/users",
    "/api/v1/audit-events",
    "/api/v1/products",
    "/api/v1/materials",
    "/api/v1/inventory",
    "/api/v1/import-batches",
    "/api/v1/selection/candidates",
    "/api/v1/watch/stores",
    "/api/v1/watch/events",
    "/api/v1/dashboard",
    "/api/v1/dashboard-maintenance",
    "/api/v1/dashboard-images",
    "/api/v1/suppliers",
    "/api/v1/catalog-images",
    "/api/v1/purchases",
    "/api/v1/product-monitoring"
  ],
  "capabilities": [
    "system.users.manage",
    "products.read", "products.write",
    "materials.read", "materials.write",
    "inventory.read", "inventory.write",
    "selection.read", "selection.write",
    "watch.read", "watch.write",
    "imports.read", "imports.template.download", "imports.validate", "imports.commit", "imports.cancel", "imports.result.download",
    "audit.read.all", "audit.read.self",
    "dashboard.read", "dashboard.shipments.manage", "dashboard.pending-products.manage",
    "suppliers.read", "suppliers.write",
    "purchases.read", "purchases.write", "purchases.receive"
  ],
  "roleCapabilities": {
    "ADMIN": [
      "system.users.manage",
      "products.read", "products.write",
      "materials.read", "materials.write",
      "inventory.read", "inventory.write",
      "selection.read", "selection.write",
      "watch.read", "watch.write",
      "imports.read", "imports.template.download", "imports.validate", "imports.commit", "imports.cancel", "imports.result.download",
      "audit.read.all", "audit.read.self",
      "dashboard.read", "dashboard.shipments.manage", "dashboard.pending-products.manage",
      "suppliers.read", "suppliers.write",
      "purchases.read", "purchases.write", "purchases.receive"
    ],
    "PRODUCT_MATERIAL": [
      "products.read", "products.write",
      "materials.read", "materials.write",
      "inventory.read", "inventory.write",
      "selection.read", "watch.read",
      "imports.read", "imports.template.download", "imports.validate", "imports.commit", "imports.cancel", "imports.result.download",
      "audit.read.self",
      "dashboard.read", "dashboard.shipments.manage", "dashboard.pending-products.manage",
      "suppliers.read", "suppliers.write",
      "purchases.read", "purchases.write", "purchases.receive"
    ],
    "SELECTION": [
      "products.read", "materials.read",
      "selection.read", "selection.write",
      "watch.read", "watch.write",
      "audit.read.self",
      "dashboard.read", "dashboard.pending-products.manage"
    ]
  },
  "excludedCurrentMvp": {
    "entities": ["StoreAccount", "AmazonCatalogItem", "StoreListing"],
    "importTypes": ["STORE_LISTINGS"],
    "apiResourceFamilies": ["/api/v1/store-accounts", "/api/v1/store-listings"],
    "capabilities": ["listings.read", "listings.write", "stores.write"],
    "businessInputs": ["DATA-002"]
  },
  "historicalContracts": ["DEL-017", "DEL-025"],
  "invariants": [
    "ERP-030 monitoring is independent, authenticated for all roles, without personnel operation audit",
    "ERP-030 P0 observations are MANUAL or SYNTHETIC; no automatic collection",
    "WatchStore is a public monitoring target and is not StoreAccount",
    "NewListingEvent does not authorize StoreListing mapping",
    "historical six-type import contracts are audit evidence rather than the current implementation scope",
    "reintroducing StoreListing requires a new approved scope decision"
  ]
}
