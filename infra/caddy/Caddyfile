{
	admin off
	auto_https off
	servers {
		# cloudflared connects locally; preserve its original HTTPS scheme.
		trusted_proxies static 127.0.0.1/32 ::1/128
	}
}

:4173 {
	bind 127.0.0.1
	root * {$ERP_FRONTEND_DIST}
	encode gzip
	header {
		X-Content-Type-Options nosniff
		X-Robots-Tag none
		Referrer-Policy same-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}
	# This SSH fallback terminates HTTPS remotely without dependable forwarded headers.
	# Match only the explicitly configured public host; retain backend Origin checks.
	@fallback_api {
		host {$ERP_FALLBACK_HOST:localhost.invalid}
		path /api/*
	}
	handle @fallback_api {
		header Cache-Control "no-store"
		reverse_proxy 127.0.0.1:8080 {
			header_up -Forwarded
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Port 443
		}
	}
	handle /api/* {
		header Cache-Control "no-store"
		reverse_proxy 127.0.0.1:8080
	}
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		header Cache-Control "no-store, max-age=0"
		try_files {path} /index.html
		file_server
	}
}
