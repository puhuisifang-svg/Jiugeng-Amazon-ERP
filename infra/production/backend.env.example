# Secrets are separate files, readable only by the application user.
ERP_MYSQL_SECRET_DIR=/etc/jiugeng/secrets/
DATABASE_USERNAME=jiugeng_erp
DATABASE_URL=jdbc:mysql://127.0.0.1:3306/jiugeng_erp?useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC&useSSL=false&allowPublicKeyRetrieval=true
DATABASE_POOL_MAX_SIZE=5
DATABASE_POOL_MIN_IDLE=1
ERP_STORAGE_PROVIDER=oss
# Populate existing OSS endpoint/region/bucket/prefix privately before starting.
ERP_OSS_CREDENTIALS_FILE=/etc/jiugeng/secrets/oss-credentials
ERP_CATALOG_IMAGE_DIR=/srv/jiugeng/data/catalog-images
ERP_DASHBOARD_IMAGE_DIR=/srv/jiugeng/data/dashboard-images
ERP_IMPORT_STAGING_DIR=/srv/jiugeng/data/import-staging
ERP_IMPORT_TEMPLATES_DIR=/srv/jiugeng/current/import-templates
ERP_FORWARDER_TEMPLATE_DIR=/srv/jiugeng/data/forwarder-templates
# Keep collection disabled until network verification and final cutover.
ERP_COLLECTION_AMAZON_ENABLED=false
ERP_WAREHOUSE_SYNC_ENABLED=false
