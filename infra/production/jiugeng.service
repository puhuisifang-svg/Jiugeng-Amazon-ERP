[Unit]
Description=Jiugeng ERP application
After=network-online.target mysql.service
Wants=network-online.target
Requires=mysql.service

[Service]
User=jiugeng
Group=jiugeng
WorkingDirectory=/srv/jiugeng/current
EnvironmentFile=/etc/jiugeng/backend.env
ExecStart=/usr/bin/java -Xms256m -Xmx1024m -XX:MaxMetaspaceSize=256m -XX:+ExitOnOutOfMemoryError -jar /srv/jiugeng/current/backend.jar --spring.profiles.active=mysql --server.address=127.0.0.1 --server.port=8080
Restart=on-failure
RestartSec=10
TimeoutStopSec=60
MemoryHigh=1400M
MemoryMax=1700M
TasksMax=256
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/jiugeng/data

[Install]
WantedBy=multi-user.target
