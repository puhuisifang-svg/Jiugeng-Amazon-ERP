(jiugeng_public_website) {
	root * {$JIUGENG_WEBSITE_ROOT:/srv/jiugeng-website/current}
	encode gzip
	header {
		Cache-Control "no-cache"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
	file_server
	handle_errors {
		@missing expression {err.status_code} == 404
		handle @missing {
			rewrite * /404.html
			file_server
		}
	}
}
